{
  "checkpoint": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "" }
  },
  "lora": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["checkpoint", 0],
      "clip": ["checkpoint", 1],
      "lora_name": "",
      "strength_model": 1.0,
      "strength_clip": 1.0
    }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["lora", 1], "text": "" }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["lora", 1], "text": "" }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 832, "height": 1216, "batch_size": 1 }
  },
  "sampler": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["lora", 0],
      "positive": ["positive", 0],
      "negative": ["negative", 0],
      "latent_image": ["latent", 0],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "lcm",
      "scheduler": "sgm_uniform",
      "denoise": 1.0
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["sampler", 0], "vae": ["checkpoint", 2] }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": { "images": ["decode", 0], "filename_prefix": "studio" }
  }
}
